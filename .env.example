# .env.example — chaves e defaults NAO-secretos deste repositorio (`T-01.7`, `ADR-029/D5`,
# `SPEC-003` s3.5). Copie para `.env` (gitignored) e ajuste se precisar — nenhum valor aqui
# e credencial (`core.hardcoded-secret`); o proprio `.gitignore` nega `.env.*` e libera de
# volta so este arquivo (`!.env.example`).
#
# `make api` honra este arquivo quando ele existir como `.env` na raiz; ausente, o processo
# cai nos defaults que `src.main`/`__main__.py` ja tem hoje.

APP_PORT=8000                                            # porta onde a API escuta (uvicorn, loopback-only, __main__.py:27)
API_PREFIX=/api/v1                                       # prefixo de toda rota da API; o Caddy segue o mesmo valor (ADR-029/D2)
INGEST_HEALTH_STORE_PATH=data/md/ingest_health.sqlite3   # caminho do SQLite que a API serve (src.main)
INGEST_HEALTH_API_BASE_URL=http://127.0.0.1:8000         # base URL que o servidor Next usa; NUNCA prefixado com NEXT_PUBLIC_ (ADR-019/D4)
                                                          # em deploy/compose.yml (T-02.6), o servico "web" le a variante
                                                          # http://api:${APP_PORT} — nome de servico, sem porta publicada (ADR-029/D5)

# ── deploy/compose.yml — leitura do "caddy" (T-02.6, ADR-029/D1) ────────────────────────
# Nenhuma das duas chaves abaixo e lida em dev (make api / npm run dev); so o Caddy do
# compose as le, e so em producao. Vazias aqui de proposito — preencher e ato de implantacao,
# fora do escopo desta task (RN-9).
PUBLIC_HOST=                                             # host publico unico do Caddy; obrigatoria em compose (${PUBLIC_HOST:?…}), ausente em dev
PANEL_BASIC_AUTH_HASH=                                   # hash bcrypt do basic_auth do Caddy; vazia = bloco de auth INERTE (ADR-029/D6; mecanismo decidido em [Q3], owner)

# ── deploy/compose.yml — Postgres, Redis e os processos de captura (T-03.3, ADR-032) ────
# Fecha o GAP G9: POSTGRES_* ja era exigido pelo compose (${POSTGRES_*:?…}) mas faltava
# aqui. Valores abaixo sao placeholders de DEV/teste — nunca credencial real (ADR-032/D3).
POSTGRES_DB=cripto_strategy_dev                          # nome do banco Postgres (ja exigido por deploy/compose.yml, G9)
POSTGRES_USER=cripto_strategy                            # usuario do Postgres (idem, G9)
POSTGRES_PASSWORD=changeme-dev-only                      # senha de DEV/teste; troque ao implantar de verdade (idem, G9)
POSTGRES_HOST=postgres                                   # nome do servico no compose; dev sem compose aponta para localhost
POSTGRES_PORT=5432                                       # porta padrao do Postgres

REDIS_HOST=redis                                         # nome do servico no compose; dev sem compose aponta para localhost
REDIS_PORT=6379                                          # porta padrao do Redis
REDIS_STREAM=md.series.write                             # Stream unico do wire (series_row_wire.py, SPEC-004 s3.2)
REDIS_STREAM_GROUP=single_writer                         # consumer group do single_writer_cli (ADR-009/D2)
REDIS_STREAM_MAXLEN=100000                               # teto do `XADD … MAXLEN ~` (ADR-032/D3); CA-F1-5 mede 24h e pode revisar
REDIS_MAXMEMORY=64mb                                     # maxmemory do redis-server, policy noeviction (ADR-032/D3): XADD falha alto, nunca descarta em silencio

INGEST_RECORD_BACKEND=postgres                           # sqlite|postgres — sqlite serve so para dev sem compose (T-02.4)
WRITER_BATCH_SIZE=100                                    # tamanho de lote do single_writer_cli por iteracao
WRITER_POLL_INTERVAL_MS=500                              # intervalo (ms) que o escritor dorme com a fila vazia
PREMIUM_INDEX_CYCLE_INTERVAL_S=60                        # intervalo (s) do ciclo premiumIndex do coletor ([Q2], gates/Q3-run-definition.md s4)

# ── frontend/.env.local — NAO e um segundo arquivo de verdade ──────────────────────────
# So e necessario para `next dev` sem docker (o Next nao le o `.env` da raiz nesse modo).
# Sob compose (deploy/compose.yml + deploy/compose.local.yml), o overlay local injeta
# INGEST_HEALTH_API_BASE_URL no servico "web" a partir DESTE arquivo unico — nenhum
# `.env.local` e necessario para subir local (ADR-032/D3, SPEC-004 s3.6.1).
